<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Every public member carries an XML doc (CS1591 is an error under TreatWarningsAsErrors). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Consumed by Blazor WebAssembly apps published trimmed: the analyzers keep it safe. -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <PackageId>OmniEurope.Documents</PackageId>
    <Authors>OmniEurope contributors</Authors>
    <Company>OmniEurope</Company>
    <Description>Create, edit, convert and read Word, Excel, PDF, Markdown and CSV documents, without OCR, without UI and without any dependency.</Description>
    <PackageTags>documents;pdf;word;excel;markdown;csv;eupl</PackageTags>
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/OmniEurope/OmniEurope.Documents</RepositoryUrl>
    <PackageProjectUrl>https://github.com/OmniEurope/OmniEurope.Documents</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <!-- Portable PDB shipped as a separate .snupkg symbol package, never embedded in the .nupkg. -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OmniEurope.Documents.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Bundled fonts (SIL OFL 1.1): embedded so PDF output never depends on fonts installed on the host. -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\Bundled\*.ttf" LogicalName="OmniEurope.Documents.Fonts.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Fonts\Bundled\LICENSE-*.txt" LogicalName="OmniEurope.Documents.Fonts.%(Filename)%(Extension)" />
    <None Include="Fonts\Bundled\LICENSE-*.txt" Pack="true" PackagePath="fonts/" />
  </ItemGroup>

  <!--
    The extra fonts (OmniEurope.Documents.Fonts.dll, a separate assembly a host may load lazily) ship in this
    package: the assembly and its XML doc in lib/, its PDB in the symbol package, its licences in fonts/extra/.
    That project references this one, so it is built here by an MSBuild call (a ProjectReference would be
    circular); the extra global property keeps its build of this project a distinct instance.
  -->
  <PropertyGroup>
    <ExtraFontsProject>$(MSBuildThisFileDirectory)..\OmniEurope.Documents.Fonts\OmniEurope.Documents.Fonts.csproj</ExtraFontsProject>
    <TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);AddExtraFontsToPackage</TargetsForTfmSpecificBuildOutput>
    <TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);AddExtraFontsSymbolsToPackage</TargetsForTfmSpecificDebugSymbolsInPackage>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\OmniEurope.Documents.Fonts\Fonts\LICENSE-*.txt;..\OmniEurope.Documents.Fonts\Fonts\NOTICE.txt" Pack="true" PackagePath="fonts/extra/" />
  </ItemGroup>

  <Target Name="ResolveExtraFontsAssembly">
    <PropertyGroup>
      <_ExtraFontsTarget>Build</_ExtraFontsTarget>
      <_ExtraFontsTarget Condition="'$(NoBuild)' == 'true'">GetTargetPath</_ExtraFontsTarget>
    </PropertyGroup>
    <MSBuild Projects="$(ExtraFontsProject)" Targets="$(_ExtraFontsTarget)" Properties="Configuration=$(Configuration);PackingExtraFonts=true">
      <Output TaskParameter="TargetOutputs" ItemName="_ExtraFontsAssembly" />
    </MSBuild>
    <Error Condition="!Exists('@(_ExtraFontsAssembly)')" Text="@(_ExtraFontsAssembly) is missing: build OmniEurope.Documents.Fonts before packing with --no-build." />
  </Target>

  <Target Name="AddExtraFontsToPackage" DependsOnTargets="ResolveExtraFontsAssembly">
    <ItemGroup>
      <_ExtraFontsOutput Include="@(_ExtraFontsAssembly->'%(FullPath)')" />
      <_ExtraFontsOutput Include="@(_ExtraFontsAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
      <BuildOutputInPackage Include="@(_ExtraFontsOutput)" FinalOutputPath="%(FullPath)" TargetPath="%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="!Exists('%(_ExtraFontsOutput.FullPath)')" Text="%(_ExtraFontsOutput.FullPath) is missing." />
  </Target>

  <Target Name="AddExtraFontsSymbolsToPackage" DependsOnTargets="ResolveExtraFontsAssembly">
    <ItemGroup>
      <_ExtraFontsSymbols Include="@(_ExtraFontsAssembly->'%(RootDir)%(Directory)%(Filename).pdb')" />
      <TfmSpecificDebugSymbolsFile Include="@(_ExtraFontsSymbols)" TargetFramework="$(TargetFramework)" FinalOutputPath="%(FullPath)" TargetPath="%(Filename)%(Extension)" />
    </ItemGroup>
    <Error Condition="!Exists('@(_ExtraFontsSymbols)')" Text="@(_ExtraFontsSymbols) is missing." />
  </Target>

  <!-- Symbol advance widths: Adobe's Core 14 metrics file, unmodified, always with its licence (MustRead.html). -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\Bundled\Adobe\Symbol.afm;Fonts\Bundled\Adobe\MustRead.html" LogicalName="OmniEurope.Documents.Fonts.Adobe.%(Filename)%(Extension)" />
    <None Include="Fonts\Bundled\Adobe\Symbol.afm;Fonts\Bundled\Adobe\MustRead.html" Pack="true" PackagePath="fonts/adobe/" />
  </ItemGroup>

  <!-- Office Open XML schemas: Ecma-376 electronic inserts, unmodified, always with their notice (NOTICE-Ecma.txt). -->
  <ItemGroup>
    <EmbeddedResource Include="Word\Schemas\Transitional\*.xsd" LogicalName="OmniEurope.Documents.Word.Schemas.Transitional.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Word\Schemas\Strict\*.xsd" LogicalName="OmniEurope.Documents.Word.Schemas.Strict.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Word\Schemas\Opc\*.xsd" LogicalName="OmniEurope.Documents.Word.Schemas.Opc.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Word\Schemas\NOTICE-Ecma.txt" LogicalName="OmniEurope.Documents.Word.Schemas.NOTICE-Ecma.txt" />
    <None Include="Word\Schemas\NOTICE-Ecma.txt" Pack="true" PackagePath="schemas/" />
  </ItemGroup>

</Project>
