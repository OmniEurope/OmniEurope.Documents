<Project Sdk="Microsoft.NET.Sdk">

  <!-- Long runs kept out of the fast suite: thousands of damaged files, large documents, parallel conversions. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.MTP" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Shared\*.cs" LinkBase="Shared" />
    <None Include="..\OmniEurope.Documents.Tests\Fixtures\**\*" Exclude="..\OmniEurope.Documents.Tests\Fixtures\**\*.ps1" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\OmniEurope.Documents\OmniEurope.Documents.csproj" />
  </ItemGroup>

</Project>
